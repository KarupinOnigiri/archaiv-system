# Copy this to .env on the Pi and fill in the real values -- .env itself is
# gitignored (it holds secrets), so this template is what actually reaches
# the device via `git clone`/`git pull`. See DEPLOYMENT.md for the full
# setup walkthrough.

# Required. Flask needs this even though sessions are DB-backed (used for
# flash messages and any future signed cookies) -- the app refuses to
# start without it. Generate a real one, don't reuse this example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 0.0.0.0 so the app is reachable from other devices on the LAN (other
# staff computers, not just a keyboard/monitor plugged into the Pi
# itself). 127.0.0.1 (loopback-only) is only correct if you're putting a
# reverse proxy (nginx/Caddy) in front of it on the same machine.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 0 for any real deployment. 1 enables the Werkzeug interactive debugger
# (arbitrary code execution from a browser if an error page is ever
# reachable) and the auto-reloader -- development only, never on a
# device other people can reach.
FLASK_DEBUG=0

# Waitress (wsgi.py) thread count. 4 matches the Pi 4B's 4 cores and this
# app being SQLite-bound, not CPU-bound -- see wsgi.py's docstring before
# raising this. Leave unset to use the default (4).
# WAITRESS_THREADS=4

# Whether session cookies require HTTPS. Independent of FLASK_DEBUG on
# purpose (see routes/auth.py) -- get this wrong in the "plain HTTP, no
# reverse proxy" setup and login will silently break (the browser drops a
# Secure cookie sent over http://, no error shown anywhere).
#
#   Serving plain HTTP directly (most Pi/LAN kiosk setups, no separate
#   reverse proxy) -- MUST be 0:
COOKIE_SECURE=0
#
#   Behind a TLS-terminating reverse proxy (nginx/Caddy with a cert), or
#   accessed over Tailscale/VPN with HTTPS -- set to 1 instead:
# COOKIE_SECURE=1

# Optional. Encrypts the database file at rest (SQLCipher). Needs
# libsqlcipher-dev installed and requirements-encryption.txt -- see
# SECURITY.md before setting this, it explains what this does and
# doesn't actually protect against, and existing databases need to be
# migrated with tools/encrypt_existing_db.py BEFORE this is set (setting it
# against a still-plaintext database will fail to start).
# DB_ENCRYPTION_KEY=


# Nothing else to configure for first boot -- the app seeds its own
# temporary setup admin automatically (services/seed_service.py), no
# credentials to fill in here. It'll print to the terminal/log and pop up
# as a modal on the login page the first time nothing else exists yet.
