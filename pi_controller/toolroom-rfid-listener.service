[Unit]
# Example systemd unit for the tool-room controller. Copy to
# /etc/systemd/system/toolroom-rfid-listener.service on the Pi, adjust the
# paths/user below to match your install, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now toolroom-rfid-listener
# Mirrors the main app's own toolroom.service (see wsgi.py's docstring) --
# runs as a separate unit since it's a separate process.
Description=Tool-room RFID/alarm headless controller
# After=toolroom.service (not Requires=/BindsTo=) is deliberately a soft
# ordering hint, not a hard dependency: this process's own retry logic
# (api_client.py, _sync_alarm_relay's poll loop) already tolerates the app
# being briefly unreachable at any point during the process's lifetime, so
# a failed/delayed toolroom.service shouldn't block this one from starting
# at all - it would just keep retrying and connect once the app comes up,
# same as it already does for a transient network hiccup later on. The
# ordering only exists to close the ~10s window at boot where, without it,
# systemd could start both units in either order and this one's very first
# few sync-loop polls would hit "connection refused" before the app was
# ready - harmless (self-recovers immediately, no missed alarm/detection
# during a machine's own boot sequence), but pure log noise worth avoiding.
After=network.target pcscd.service toolroom.service
Wants=pcscd.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/toolroom
ExecStart=/home/pi/toolroom/.venv-pi-controller/bin/python -m pi_controller.rfid_listener
Restart=on-failure
RestartSec=5
# GPIO/USB-HID access needs the pi user in the gpio/input/plugdev groups
# (raspi-config or `sudo usermod -aG gpio,input,plugdev pi`), not root.

[Install]
WantedBy=multi-user.target
