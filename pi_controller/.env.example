# Copy this to pi_controller/.env and fill in the real values. This is a
# SEPARATE .env from the main web app's own .env -- this controller is a
# different process (see this folder's README.md), even when it runs on
# the same Pi as the Flask app.

# Where the web app is reachable. Same Pi, most setups -- see README.md.
APP_BASE_URL=http://127.0.0.1:5000

# Required. Must match RFID_LISTENER_KEY in the main project's own .env
# exactly -- this is the shared secret both machine-to-machine endpoints
# check (routes/monitoring.py). Generate one, then copy it into BOTH
# .env files:
#   python -c "import secrets; print(secrets.token_hex(32))"
RFID_LISTENER_KEY=

# --- Fixed UHF RFID Reader Antenna (monitored exit) ------------------------
#
# Two transports are supported -- USB and network -- and dual_reader.py picks
# whichever one is actually present automatically at startup, so only fill in
# the section that matches how the antenna is actually wired (leaving the
# other blank is fine).

# USB transport. Substring of the input device name the reader reports once
# set to USB_HID output mode. Find it on the Pi with:
#   cat /proc/bus/input/devices
# or:
#   python -m evdev.evtest
# Look for an entry that appears/disappears when you plug/unplug the reader.
HID_DEVICE_NAME=

# Network transport, for when the antenna is too far from the Pi to run USB.
# Requires the antenna to be switched from USB_HID to NET output mode first
# (via the vendor's RFIDDemo tool, over a one-off USB connection) and given a
# static IP that matches what you set here. Leave NET_DEVICE_IP blank to
# disable this transport entirely (dual_reader.py will only try USB).
NET_DEVICE_IP=
NET_DEVICE_PORT=49152

# Repeated reads of the same tag within this many seconds count as one
# detection event -- matches the thesis's stated 1-second cooldown.
DEDUP_COOLDOWN_SECONDS=1.0

# --- HF/NFC Reader/Writer (Master Key Card alarm deactivation) -------------

# Optional. Substring of the PC/SC reader name (e.g. "ACR122U"). Leave
# blank to just use the first/only PC/SC reader found -- fine when this is
# the only smart-card reader attached to the Pi (the workstation's ACR122U
# is a separate physical unit on the staff PC, not this device).
PCSC_READER_NAME=

# --- Alarm relay (GPIO) -----------------------------------------------------

# BCM pin number wired to the 2-channel relay module. Match your actual
# wiring -- the thesis doesn't fix a specific pin.
ALARM_RELAY_GPIO_PIN=17

# Set to 0 if your relay module is active-low (energizes on a LOW signal
# rather than HIGH) -- check the module's datasheet/silkscreen.
ALARM_RELAY_ACTIVE_HIGH=1

# How often (seconds) this controller polls the app's public alarm-status
# endpoint to keep the relay synced with the app -- this is what makes the
# admin/in_charge password-dismiss fallback in the app also silence the
# physical lamp/buzzer, not just the database record. That endpoint is
# rate-limited to 90/min -- keep this at 3.0+ to stay under it with margin.
ALARM_SYNC_POLL_SECONDS=3.0

# Set to 1 to develop/test this on a regular PC with no Pi hardware
# attached -- GPIO/PC-SC/evdev calls all become console-logged no-ops.
DRY_RUN=0

LOG_LEVEL=INFO
