.env
.venv/
__pycache__/
*.pyc
instance/
*.log
*.log.*
backups/
.pytest_cache/

# Default save location for user-initiated asset exports (utils/exports.py's
# default_export_dir()) - recreated automatically via os.makedirs on first
# save, so nothing here needs to be committed. Project documentation (e.g.
# architecture diagrams) belongs in docs/ instead, not export/.
export/

# instance/ already covers the real DB path (database.py's DB_PATH), but
# a stray copy at the repo root (toolroom.db) got committed once before
# - see the repo-hygiene history rewrite. Catch any *.db file wherever
# it turns up so that can't happen again.
*.db
# Tailwind CLI binary - 100MB+, download separately (see DEPLOYMENT.md)
tools/tailwindcss.exe

# Reference material (RFID reader vendor SDKs, thesis paper technical specs)
# that ended up sitting directly inside the repo working tree - not project
# source, and its Android/.NET vendor SDKs nest deep enough to blow past
# Windows' MAX_PATH, which broke `git add -A` outright until this was added.
THESIS PAPER/

# Stray file some earlier `... > nul` redirect created literally (Git Bash
# doesn't map "nul" to the Windows NUL device the way cmd.exe does) - not a
# real project file, but harmless enough to just keep untracked if it recurs
# rather than something worth chasing down and fixing at the source.
/nul
